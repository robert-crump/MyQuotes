<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Background color of the status-bar scrim strip drawn behind the transparent status bar
         on edge-to-edge (API 35+) screens; matches appBarColor so status bar and app bar read as
         one tinted band. See EdgeToEdgeUtils. -->
    <attr name="statusBarScrimColor" format="color" />

    <!-- Top app bar background on every screen: the brand pink in the light theme, the brand
         purple in the dark theme. -->
    <attr name="appBarColor" format="color" />

    <!-- App bar (and status-bar scrim) while a list is in selection mode, e.g. Hashtags: a
         darker tone than appBarColor so the mode change is obvious. -->
    <attr name="selectionBarColor" format="color" />

</resources>
