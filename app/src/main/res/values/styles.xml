<resources>
    <!-- Toolbar Style -->
    <style name="ToolbarStyle" parent="Widget.AppCompat.Toolbar">
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="android:textColorSecondary">?attr/colorOnPrimary</item>
    </style>

    <!-- Theme Overlay für Toolbar - Generic (used by Favorites and Settings) -->
    <style name="ThemeOverlay.MyApp.Toolbar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorSecondary">?attr/colorOnPrimary</item>
        <item name="colorControlNormal">?attr/colorOnPrimary</item>
    </style>

    <!-- Theme Overlay für Toolbar mit schwarzen Icons im Light Mode -->
    <style name="ThemeOverlay.MyApp.Toolbar.Light" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorSecondary">?attr/colorOnPrimary</item>
        <item name="colorControlNormal">?attr/colorOnPrimary</item>
    </style>

    <!-- Theme Overlay für Toolbar mit weißen Icons im Dark Mode -->
    <style name="ThemeOverlay.MyApp.Toolbar.Dark" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorSecondary">?attr/colorOnPrimary</item>
        <item name="colorControlNormal">?attr/colorOnPrimary</item>
    </style>

    <!-- Toolbar Title -->
    <style name="ToolbarTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Menu Item Style -->
    <style name="MenuItemStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:itemTextAppearance">@style/MenuItemText</item>
    </style>

    <!-- Menu Text Style -->
    <style name="MenuItemText" parent="TextAppearance.AppCompat.Menu">
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- FAB Shape - eckig mit abgerundeten Ecken -->
    <style name="ShapeAppearance.MyApp.FAB" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- CardView Style -->
    <style name="CardViewStyle" parent="CardView">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?android:attr/textColorSecondary</item>
    </style>
</resources>