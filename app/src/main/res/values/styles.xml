<resources>
    <!-- Menu Item Style -->
    <style name="MenuItemStyle" parent="Widget.AppCompat.PopupMenu">
        <item name="android:itemTextAppearance">@style/MenuItemText</item>
    </style>

    <!-- Menu Text Style -->
    <style name="MenuItemText" parent="TextAppearance.AppCompat.Menu">
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- FAB Shape - MD3 "large" corner token (16dp) -->
    <style name="ShapeAppearance.MyApp.FAB" parent="ShapeAppearance.Material3.Corner.Large" />

    <!-- CardView Style -->
    <style name="CardViewStyle" parent="CardView">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>

    <!-- Search field filter: colour alone shows on/off (filled = searched), no check or close icon -->
    <style name="Widget.MyQuotes.SearchFilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:checkable">true</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/search_filter_chip_text</item>
        <item name="chipBackgroundColor">@color/search_filter_chip_bg</item>
        <item name="chipStrokeColor">?attr/colorPrimary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">16dp</item>
    </style>
</resources>
