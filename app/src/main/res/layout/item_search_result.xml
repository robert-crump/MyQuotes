<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Medium"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Nummer des Suchergebnisses -->
        <TextView
            android:id="@+id/text_search_result_number"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:text="1"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Autor & Quelle -->
            <TextView
                android:id="@+id/text_author_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Author - Source"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@android:color/darker_gray"
                android:maxLines="1"
                android:ellipsize="end"
                android:textStyle="italic" />

            <!-- Zitat-Snippet mit Highlighting -->
            <TextView
                android:id="@+id/text_quote_snippet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Quote snippet"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/dark_text"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>