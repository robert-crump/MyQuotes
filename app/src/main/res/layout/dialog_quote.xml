<?xml version="1.0" encoding="utf-8"?>
<!-- Search result dialog: the quote card centred over the dimmed screen, a small close button
     above its top-end corner. The root spans the screen; a tap on it (outside the card) closes. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/quote_dialog_side_margin"
    android:paddingTop="48dp"
    android:paddingEnd="@dimen/quote_dialog_side_margin"
    android:paddingBottom="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/button_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginBottom="8dp"
            android:background="@drawable/quote_dialog_close_background"
            android:contentDescription="@string/quote_dialog_close"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurface" />

        <!-- Weight lets a long quote shrink the scroller to the space left, so it scrolls inside
             the card; a short one wraps. The scroller consumes taps, so they don't close. -->
        <ScrollView
            android:id="@+id/quote_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fadeScrollbars="true">

            <include
                layout="@layout/view_quote_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </ScrollView>

    </LinearLayout>

</FrameLayout>
