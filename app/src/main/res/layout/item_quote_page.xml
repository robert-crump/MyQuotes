<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Quote Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Medium"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/text_quote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Your quote will appear here..."
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:lineSpacingExtra="4dp"
                    android:textStyle="italic"
                    android:textColor="?android:attr/textColorPrimary"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/text_author"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:maxWidth="240dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="80dp"
                    android:text="Author"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:chipBackgroundColor="?attr/colorPrimaryContainer"
                    app:chipStrokeWidth="0dp"
                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toBottomOf="@id/text_quote"
                    app:layout_constraintStart_toStartOf="parent"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/text_source"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:maxWidth="240dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="80dp"
                    android:text="Source"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="?android:attr/textColorSecondary"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="?attr/colorOutlineVariant"
                    app:chipStrokeWidth="1dp"
                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/text_author"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/text_category"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:maxWidth="240dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="80dp"
                    android:text="Category"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="?android:attr/textColorSecondary"
                    app:chipBackgroundColor="@android:color/transparent"
                    app:chipStrokeColor="?attr/colorOutlineVariant"
                    app:chipStrokeWidth="1dp"
                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/text_source"
                    app:layout_constraintStart_toStartOf="parent"/>

                <!-- Barrier um das unterste sichtbare Element zu finden -->
                <androidx.constraintlayout.widget.Barrier
                    android:id="@+id/barrier_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:barrierDirection="bottom"
                    app:constraint_referenced_ids="text_author,text_source,text_category" />

                <!-- Favorite and Share Button Row -->
                <LinearLayout
                    android:id="@+id/button_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end|center_vertical"
                    app:layout_constraintBottom_toBottomOf="@id/barrier_bottom"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Favorite Button (Icon-Button) -->
                    <ImageButton
                        android:id="@+id/button_favorite"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_favorite_heart"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Add to favorites"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="-4dp"
                        android:scaleType="centerInside"/>

                    <!-- Share Button -->
                    <ImageButton
                        android:id="@+id/button_share"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_share"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_marginBottom="-4dp"
                        android:contentDescription="Share quote" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>