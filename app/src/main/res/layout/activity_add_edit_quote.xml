<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Status bar scrim: sized to the status bar inset height at runtime -->
    <View
        android:id="@+id/status_bar_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/statusBarScrimColor" />

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:theme="@style/ThemeOverlay.MyQuotes.AppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        style="@style/Widget.Material3.Toolbar.Surface"
        android:background="?attr/appBarColor"
        app:navigationIcon="@drawable/ic_close"
        app:navigationContentDescription="Close" />

    <!-- Form -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- Author Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="Author *"
                app:boxBackgroundColor="@android:color/transparent"
                style="@style/Widget.Material3.TextInputLayout.FilledBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="12dp"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Source Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:hint="Source"
                app:boxBackgroundColor="@android:color/transparent"
                style="@style/Widget.Material3.TextInputLayout.FilledBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="12dp"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Hashtags: the tags as input chips, then the text being typed, wrapping onto more
                 lines (AddEditActivity). Space, Enter, comma or a dropdown pick commits a chip. -->
            <LinearLayout
                android:id="@+id/hashtag_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/label_hashtags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Hashtags"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_hashtags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="0dp">

                    <AutoCompleteTextView
                        android:id="@+id/edit_text_hashtags"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="120dp"
                        android:background="@null"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:hint="Add a hashtag"
                        android:inputType="text|textNoSuggestions"
                        android:imeOptions="actionDone"
                        android:maxLines="1"
                        android:completionThreshold="1"
                        android:dropDownAnchor="@id/hashtag_field"
                        android:dropDownWidth="match_parent"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

                </com.google.android.material.chip.ChipGroup>

                <View
                    android:id="@+id/hashtag_underline"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOnSurfaceVariant" />

                <!-- Room for a later "Suggested:" row of tag suggestions. -->

            </LinearLayout>

            <!-- Quote Text Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="Quote *"
                app:boxBackgroundColor="@android:color/transparent"
                style="@style/Widget.Material3.TextInputLayout.FilledBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_text_quote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="12dp"
                    android:gravity="top|start"
                    android:imeOptions="actionDone"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="6"
                    android:maxLines="6"
                    android:scrollbars="vertical"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="* Required fields"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@android:color/darker_gray"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
