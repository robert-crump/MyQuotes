<?xml version="1.0" encoding="utf-8"?>
<!-- One suggested tag under the Add/Edit hashtag field (HashtagSuggestionRow): an outlined assist
     chip with a +, unlike the quote's own input chips. A tap adds it. -->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.Chip.Assist"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:chipIcon="@drawable/ic_add_24dp"
    app:chipIconTint="?attr/colorPrimary"
    app:chipIconVisible="true" />
