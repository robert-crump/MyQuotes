<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Notification permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_quoteicon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_quoteicon"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyQuotes">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="My Quotes: Main Page"
            android:theme="@style/Theme.MyQuotes.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SearchActivity"
            android:label="Search"
            android:theme="@style/Theme.MyQuotes.NoActionBar"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".AddEditActivity"
            android:label="Add/Edit Quote"
            android:theme="@style/Theme.MyQuotes.NoActionBar"/>

        <activity
            android:name=".StatisticsActivity"
            android:label="Statistics"
            android:theme="@style/Theme.MyQuotes.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".FavoritesActivity"
            android:label="Favorites"
            android:theme="@style/Theme.MyQuotes.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:label="Settings"
            android:theme="@style/Theme.MyQuotes.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".CategoriesActivity"
            android:label="Categories"
            android:theme="@style/Theme.MyQuotes.NoActionBar"
            android:parentActivityName=".MainActivity" />

        <!-- Broadcast receiver for boot re-schedule -->
        <receiver
            android:name=".notifications.QuoteNotificationReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>